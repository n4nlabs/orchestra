{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Orchestra Setup",
	"version": "../../package.json",
	"identifier": "com.orchestra.setup",
	"build": {
		"frontendDist": "../src"
	},
	"app": {
		"withGlobalTauri": true,
		"windows": [
			{
				"label": "main",
				"title": "Instalador do Orchestra",
				"width": 820,
				"height": 560,
				"resizable": false,
				"maximizable": false,
				"decorations": false,
				"center": true
			}
		],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": false,
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/icon.ico"
		],
		"publisher": "N4nLabs",
		"copyright": "Copyright © 2026 N4nLabs"
	}
}
